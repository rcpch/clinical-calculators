#!/usr/bin/env bash
# Linting script for Clinical Calculators project
# Runs black, isort, and ruff for code quality

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running code quality checks..."
echo ""

# Check if we're in a container or local environment
if [ -f /.dockerenv ]; then
    # In Docker container
    PYTHON_CMD="python"
else
    # Local environment
    PYTHON_CMD="python3"
fi

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Ensure linting tools are installed
if ! $PYTHON_CMD -c "import black" 2>/dev/null; then
    echo -e "${YELLOW}Installing linting dependencies...${NC}"
    pip install -e ".[dev]" > /dev/null 2>&1
    echo ""
fi

# Run Black (code formatter)
echo -e "${YELLOW}Running Black...${NC}"
if $PYTHON_CMD -m black --check calculators core cli api tests 2>&1; then
    echo -e "${GREEN}✓ Black: All files are properly formatted${NC}"
else
    echo -e "${RED}✗ Black: Some files need formatting${NC}"
    echo -e "${YELLOW}Run 'black calculators core cli api tests' to fix${NC}"
    BLACK_FAILED=1
fi
echo ""

# Run isort (import sorter)
echo -e "${YELLOW}Running isort...${NC}"
if $PYTHON_CMD -m isort --check-only calculators core cli api tests 2>&1; then
    echo -e "${GREEN}✓ isort: All imports are properly sorted${NC}"
else
    echo -e "${RED}✗ isort: Some imports need sorting${NC}"
    echo -e "${YELLOW}Run 'isort calculators core cli api tests' to fix${NC}"
    ISORT_FAILED=1
fi
echo ""

# Run Ruff (linter)
echo -e "${YELLOW}Running Ruff...${NC}"
if $PYTHON_CMD -m ruff check calculators core cli api tests 2>&1; then
    echo -e "${GREEN}✓ Ruff: No linting issues found${NC}"
else
    echo -e "${RED}✗ Ruff: Some linting issues found${NC}"
    echo -e "${YELLOW}Run 'ruff check --fix calculators core cli api tests' to auto-fix${NC}"
    RUFF_FAILED=1
fi
echo ""

# Summary
if [ -n "$BLACK_FAILED" ] || [ -n "$ISORT_FAILED" ] || [ -n "$RUFF_FAILED" ]; then
    echo -e "${RED}❌ Linting failed. Please fix the issues above.${NC}"
    exit 1
else
    echo -e "${GREEN}✅ All linting checks passed!${NC}"
    exit 0
fi

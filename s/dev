#!/usr/bin/env bash
set -euo pipefail

# Dev helper for Dockerized workflow
# Usage:
#   s/dev up        # build and start with reload
#   s/dev down      # stop and remove containers
#   s/dev logs      # tail logs
#   s/dev rebuild   # rebuild image and restart
#   s/dev sh        # open a shell in the running api container
#   s/lint          # run code quality checks (black, isort, ruff)

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"
cd "$repo_root"

cmd="${1:-up}"

# Explicit compose command to include the override file used in dev
COMPOSE_CMD="docker compose -f docker-compose.yml -f docker-compose.dev.yml"

case "$cmd" in
  up)
    # Ensure a .env exists for local development (use example if present)
    if [ ! -f .env ]; then
      if [ -f .env.example ]; then
        cp .env.example .env
        echo "Created .env from .env.example — edit values as needed"
      else
        cat > .env <<EOF
OLLAMA_BASE_URL=${OLLAMA_BASE_URL:-}
OLLAMA_API_KEY=${OLLAMA_API_KEY:-}
OLLAMA_MODEL=${OLLAMA_MODEL:-qwen3:30b}
GITHUB_TOKEN=${GITHUB_TOKEN:-}
OLLAMA_ENABLED=${OLLAMA_ENABLED:-false}
EOF
        echo "Created minimal .env — edit values as needed"
      fi
    fi

    $COMPOSE_CMD up --build -d
    echo "API available at http://localhost:8000 (docs at /docs)"
    ;;
  down)
    $COMPOSE_CMD down
    ;;
  logs)
    $COMPOSE_CMD logs -f
    ;;
  rebuild)
    $COMPOSE_CMD build --no-cache
    $COMPOSE_CMD up -d
    ;;
  sh)
    cid=$($COMPOSE_CMD ps -q api)
    if [[ -z "$cid" ]]; then
      echo "api container not running; starting..."
      $COMPOSE_CMD up -d
      cid=$($COMPOSE_CMD ps -q api)
    fi
    docker exec -it "$cid" /bin/bash || docker exec -it "$cid" /bin/sh
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Usage: $0 {up|down|logs|rebuild|sh}" >&2
    exit 2
    ;;
esac

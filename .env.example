# Ollama Configuration
# URL for hosted Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for test generation
OLLAMA_MODEL=llama2

# Optional: API key for hosted Ollama (if required)
OLLAMA_API_KEY=your_api_key_here

# GitHub Configuration (for PR automation)
# Personal access token with repo and workflow permissions
GITHUB_TOKEN=your_github_token_here

# Optional: Override repository owner and name
# GITHUB_REPO_OWNER=rcpch
# GITHUB_REPO_NAME=clinical-calculators
